{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "MCP Request Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (http_route)",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MCP 5xx Error Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MCP p50/p95/p99 Latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le))",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Brief Pushes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ebrain_brief_pushed_total[1h])) by (provider,channel,status)",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Detected Conflicts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ebrain_conflict_detected_total[1h])) by (severity)",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cycle Duration p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ebrain_cycle_duration_seconds_bucket[15m])) by (le,phase,status))",
          "legendFormat": "{{operation}}{{ingest_source_type}}{{provider}}{{model}}{{severity}}{{phase}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "ebrain",
    "p0"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up, service_name)",
        "current": {
          "text": "ebrain",
          "value": "ebrain"
        },
        "hide": 0,
        "includeAll": false,
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Ebrain Overview",
  "uid": "ebrain-overview",
  "version": 1
}
